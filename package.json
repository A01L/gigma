{
  "name": "gigma",
  "productName": "Gigma",
  "version": "0.3.15",
  "description": "Offline, open-source desktop design tool with a built-in MCP server.",
  "license": "MIT",
  "author": "Nuradil Takhirov (A01L)",
  "homepage": "https://github.com/A01L/gigma",
  "repository": {
    "type": "git",
    "url": "https://github.com/A01L/gigma.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "electron scripts/make-icons.cjs",
    "installer-art": "electron scripts/make-installer-art.cjs",
    "smoke": "node scripts/mcp-smoke.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "site:css": "tailwindcss -i site/src/input.css -o site/assets/site.css --minify",
    "site:dev": "tailwindcss -i site/src/input.css -o site/assets/site.css --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fzstd": "^0.1.1",
    "kiwi-schema": "^0.5.0",
    "paper": "^0.12.18",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^24.9.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "rbush": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.gigma.desktop",
    "productName": "Gigma",
    "files": [
      "out/**/*",
      "bin/**/*",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "gigma",
        "name": "Gigma Design",
        "role": "Editor",
        "icon": "file-icon"
      },
      {
        "ext": "gguide",
        "name": "Gigma Guideline",
        "role": "Editor",
        "icon": "guide-icon"
      },
      {
        "ext": "gplug",
        "name": "Gigma Plugin",
        "role": "Editor",
        "icon": "plug-icon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Gigma-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "include": "build/installer.nsh",
      "license": "LICENSE",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gigma",
      "uninstallDisplayName": "Gigma 26 Patch ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "directories": {
      "buildResources": "build"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage"
      ]
    }
  }
}
