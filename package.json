{
  "name": "gigma",
  "productName": "Gigma",
  "version": "0.1.0",
  "description": "Offline, open-source desktop design tool with a built-in MCP server.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "electron scripts/make-icons.cjs",
    "smoke": "node scripts/mcp-smoke.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fzstd": "^0.1.1",
    "kiwi-schema": "^0.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "rbush": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.gigma.desktop",
    "productName": "Gigma",
    "files": [
      "out/**/*",
      "bin/**/*",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "gigma",
        "name": "Gigma Design",
        "role": "Editor",
        "icon": "file-icon"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "directories": {
      "buildResources": "build"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage"
      ]
    }
  }
}
