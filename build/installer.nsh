; Gigma: custom pages of the Windows installer (electron-builder, NSIS assisted mode).
; The artwork is generated by scripts/make-installer-art.cjs:
;   build/installer-sidebar.bmp (welcome / finish pages) and build/installer-header.bmp (other pages).

!macro customHeader
  ; these run at global scope right after the languages are loaded
  BrandingText "Gigma ${VERSION}  ·  github.com/A01L/gigma"

  LangString gigmaWelcomeTitle ${LANG_ENGLISH} "Welcome to Gigma"
  LangString gigmaWelcomeTitle ${LANG_RUSSIAN} "Добро пожаловать в Gigma"
  LangString gigmaWelcomeText ${LANG_ENGLISH} "Gigma is a free, open-source design tool that works offline and feels like Figma.$\r$\n$\r$\nYour projects stay on this computer. A built-in MCP server lets AI assistants draw right on your canvas.$\r$\n$\r$\nClick Next to choose where to install it."
  LangString gigmaWelcomeText ${LANG_RUSSIAN} "Gigma это бесплатный редактор дизайна с открытым кодом. Он работает без интернета и привычен тем, кто знает Figma.$\r$\n$\r$\nПроекты хранятся на этом компьютере. Встроенный MCP-сервер позволяет ИИ-ассистентам рисовать прямо на вашем холсте.$\r$\n$\r$\nНажмите «Далее», чтобы выбрать папку установки."
  LangString gigmaFinishTitle ${LANG_ENGLISH} "Gigma is ready"
  LangString gigmaFinishTitle ${LANG_RUSSIAN} "Gigma установлена"
  LangString gigmaFinishText ${LANG_ENGLISH} "Files with the .gigma extension now open in Gigma. Plugins (.plug.gigma) are installed from Settings → Plugins."
  LangString gigmaFinishText ${LANG_RUSSIAN} "Файлы .gigma теперь открываются в Gigma. Плагины (.plug.gigma) устанавливаются в разделе Настройки → Плагины."
  LangString gigmaFinishLink ${LANG_ENGLISH} "Source code and news: github.com/A01L/gigma"
  LangString gigmaFinishLink ${LANG_RUSSIAN} "Исходный код и новости: github.com/A01L/gigma"
!macroend

!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "$(gigmaWelcomeTitle)"
  !define MUI_WELCOMEPAGE_TEXT "$(gigmaWelcomeText)"
  !insertmacro MUI_PAGE_WELCOME
!macroend

!macro customFinishPage
  ; same "run the app" behaviour as the default finish page, plus our own texts and a link
  Function StartApp
    ${if} ${isUpdated}
      StrCpy $1 "--updated"
    ${else}
      StrCpy $1 ""
    ${endif}
    ${StdUtils.ExecShellAsUser} $0 "$launchLink" "open" "$1"
  FunctionEnd

  !define MUI_FINISHPAGE_TITLE "$(gigmaFinishTitle)"
  !define MUI_FINISHPAGE_TEXT "$(gigmaFinishText)"
  !define MUI_FINISHPAGE_RUN
  !define MUI_FINISHPAGE_RUN_FUNCTION "StartApp"
  !define MUI_FINISHPAGE_LINK "$(gigmaFinishLink)"
  !define MUI_FINISHPAGE_LINK_LOCATION "https://github.com/A01L/gigma"
  !define MUI_FINISHPAGE_NOREBOOTSUPPORT
  !insertmacro MUI_PAGE_FINISH
!macroend
